// bf1943.exe's file details (Properties > Details), as King Kong's exe carries them: an anonymous large unsigned exe
// looks worse to Smart App Control and antivirus scanners (KK handover-bf/04-launcher-release.md 3.3).
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @BF_VERSION_MAJOR@,@BF_VERSION_MINOR@,@BF_VERSION_PATCH@,@BF_VERSION_HOTFIX@
 PRODUCTVERSION @BF_VERSION_MAJOR@,@BF_VERSION_MINOR@,@BF_VERSION_PATCH@,@BF_VERSION_HOTFIX@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080904b0"
    BEGIN
      VALUE "CompanyName", "TekRantGaming"
      VALUE "FileDescription", "Battlefield 1943 Reborn"
      VALUE "FileVersion", "@BF_VERSION@"
      VALUE "InternalName", "bf1943"
      VALUE "LegalCopyright", "Battlefield 1943 Reborn, a fan project by TekRantGaming. Not affiliated with EA or DICE."
      VALUE "OriginalFilename", "bf1943.exe"
      VALUE "ProductName", "Battlefield 1943 Reborn"
      VALUE "ProductVersion", "@BF_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x809, 1200
  END
END
