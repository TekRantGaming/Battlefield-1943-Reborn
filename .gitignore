# Players bring their own copy of the game. None of it goes in git, and nothing made from it either (README, Legal):
# the game's package and files, the code the generator makes from default.xex, extracted pictures and sounds.
/bf/assets
/bf/generated/
/input/
/Game Files/
*.xex
*.fbrb
*.zz
/bf/**/*.bin
# (Our own: the storms' radar patterns, baked from public domain NWS radar by tools/storm_bake.py, D228.)
!/bf/data/weather/storms/*.bin
/bf/**/*.res
/bf/**/*.dds
/bf/**/*.wav
/bf/**/*.xma
# Pictures in the game's folders: only our own (the button glyphs, the TRG Studios logo, the Linux icon, our own
# achievements' pictures from tools/make_reborn_achievements.py).
/bf/**/*.png
/bf/**/*.jpg
!/bf/glyphs/**/*.png
!/bf/data/startup/trg_studios.png
!/bf/data/linux/bf1943-reborn.png
!/bf/data/achievements/*.png
# The server type page's card pictures: stills from TekRantGaming's own 0.4.8 trailer footage (27 Nov 2026).
!/bf/data/modes/*.jpg

# Builds, test runs and tool output
/bf/out/
/sdk/src-bf/out/
/runs/
/build/
/ghidra/
/deps/
*.pdb
__pycache__/
*.pyc

# The official servers' key: never in git, never in a download
*.key

# System files
Thumbs.db
.DS_Store

# A developer's own build switches (bf/CMakeLists.txt includes it when it is there): BF_INTERNAL_TOOLS and the like.
/bf/local.cmake
